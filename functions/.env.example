# Variables de entorno para Firebase Functions
# NO SUBIR ESTE ARCHIVO A GIT

# Webhook de Slack para notificaciones de admin (negocios pendientes de revisión)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Credenciales de Gmail para enviar emails a dueños de negocios (usar App Password)
EMAIL_USER=tu_email_gmail@gmail.com
EMAIL_PASS=tu_app_password_de_gmail

# Registration v2 sigue en Etapa 1. No activar Claims ni Email Link aquí.
PUBLIC_APPLICATION_V2_ENABLED=false
OWNERSHIP_CLAIMS_ENABLED=false
EMAIL_LINK_AUTH_ENABLED=false

# 0.2R.2.1 Telegram admin alerts (disabled until external setup is complete)
TELEGRAM_APPLICATION_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=replace_with_secret_manager_value
TELEGRAM_ADMIN_CHAT_ID=replace_with_admin_chat_id
ADMIN_PANEL_BASE_URL=https://www.yajagon.com

# Cómo obtener el Slack Webhook URL:
# 1. Ve a https://api.slack.com/apps
# 2. Crea una nueva app o selecciona una existente
# 3. Ve a "Incoming Webhooks" y actívalo
# 4. Crea un nuevo webhook para el canal donde quieres recibir notificaciones
# 5. Copia la URL que te dan (empieza con https://hooks.slack.com/services/)

# Ejemplo de App Password de Gmail:
# 1. Ve a https://myaccount.google.com/security
# 2. Habilita verificación en 2 pasos
# 3. Busca "App passwords" y genera una nueva
# 4. Copia la contraseña de 16 caracteres
