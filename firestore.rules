rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Helpers --------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Admin via Custom Claims: { admin: true }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Un negocio solo tiene propietario autenticado cuando ownerId existe y coincide.
    // Los negocios de alta asistida pueden no tener ownerId y siguen siendo administrables por admin.
    function isOwner(businessId) {
      let biz = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      return isSignedIn()
        && ('ownerId' in biz)
        && biz.ownerId is string
        && biz.ownerId.size() > 0
        && biz.ownerId == request.auth.uid;
    }

    function isOwnerResource() {
      return isSignedIn()
        && ('ownerId' in resource.data)
        && resource.data.ownerId is string
        && resource.data.ownerId.size() > 0
        && resource.data.ownerId == request.auth.uid;
    }

    function isPublicBusiness() {
      let adminStatus = resource.data.get('adminStatus', 'active');
      let visibility = resource.data.get('visibility', 'published');
      let active = resource.data.get('isActive', true);
      return ('businessStatus' in resource.data)
        && resource.data.businessStatus == 'published'
        && adminStatus == 'active'
        && visibility == 'published'
        && active == true;
    }

    function validString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function optionalString(val, max) {
      return !(val is string) || (val is string && val.size() <= max);
    }

    function validStatus(val) {
      return val in ['pending','draft','review','published','rejected'];
    }

    // NUEVO: Validar businessStatus
    function validBusinessStatus(val) {
      return val in ['draft', 'in_review', 'published'];
    }

    // NUEVO: Validar applicationStatus
    function validApplicationStatus(val) {
      return val in ['submitted', 'needs_info', 'ready_for_review', 'approved', 'rejected'];
    }

    // ============== APPLICATIONS (Solicitudes iniciales) ==============
    match /applications/{uid} {
      // Lectura individual: solo el usuario o admin
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      
      // Queries restringidas: solo el propio usuario o admin
      allow list: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Creación: usuario autenticado crea su propia solicitud
      allow create: if isVerifiedEmail()
        && uid == request.auth.uid
        && validApplicationCreate();

      // Actualización: el usuario puede actualizar su propia solicitud o admin
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && validApplicationUserUpdate()) ||
        (isAdmin() && validApplicationAdminUpdate())
      );

      // Eliminación: solo admin
      allow delete: if isAdmin();

      function validApplicationCreate() {
        return
          // Datos básicos requeridos
          validString(request.resource.data.ownerName, 2, 140) &&
          validString(request.resource.data.ownerEmail, 5, 200) &&
          validString(request.resource.data.businessName, 2, 140) &&
          optionalString(request.resource.data.ownerPhone, 30) &&
          optionalString(request.resource.data.category, 80) &&
          optionalString(request.resource.data.phone, 30) &&
          optionalString(request.resource.data.whatsapp, 30) &&
          // Status debe ser pending al crear
          (!('status' in request.resource.data) || request.resource.data.status == 'pending') &&
          // UID debe coincidir
          (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
          // Timestamps opcionales
          (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp) &&
          (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      }

      function validApplicationUserUpdate() {
        return
          // Usuario puede actualizar sus datos mientras esté pending
          resource.data.status == 'pending' &&
          validString(request.resource.data.ownerName, 2, 140) &&
          validString(request.resource.data.ownerEmail, 5, 200) &&
          validString(request.resource.data.businessName, 2, 140) &&
          optionalString(request.resource.data.ownerPhone, 30) &&
          optionalString(request.resource.data.category, 80) &&
          optionalString(request.resource.data.phone, 30) &&
          optionalString(request.resource.data.whatsapp, 30) &&
          // No puede cambiar el status
          request.resource.data.status == resource.data.status &&
          (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      }

      function validApplicationAdminUpdate() {
        return
          // Admin puede cambiar status y otros campos
          (!('status' in request.resource.data) || validStatus(request.resource.data.status)) &&
          optionalString(request.resource.data.ownerName, 140) &&
          optionalString(request.resource.data.ownerEmail, 200) &&
          optionalString(request.resource.data.businessName, 140) &&
          optionalString(request.resource.data.ownerPhone, 30) &&
          optionalString(request.resource.data.category, 80) &&
          optionalString(request.resource.data.phone, 30) &&
          optionalString(request.resource.data.whatsapp, 30) &&
          (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      }
    }

    // ============== BUSINESSES ==============
    match /businesses/{businessId} {
      // Lectura individual: publica solo con el predicado canonico; privada para ownerId o admin.
      allow get: if isPublicBusiness() || isOwner(businessId) || isAdmin();
      
      // Las reglas no filtran: el cliente debe consultar solo documentos demostrablemente
      // publicos o limitar la consulta a su ownerId. Un admin puede listar sin limite.
      allow list: if isAdmin() ||
                    (request.query.limit <= 100 && (isPublicBusiness() || isOwnerResource()));

      // Creación: admin puede crear (para el flujo de aprobación)
      // O usuario puede crear draft con su ownerId
      allow create: if (isAdmin() && validBusinessAdminCreate()) ||
                       (isSignedIn() && validBusinessUserCreate());

      // Actualización: dueño con límites / admin con controles
      allow update: if (isOwner(businessId) && validBusinessOwnerUpdate()) ||
                       (isAdmin() && validBusinessAdminUpdate());

      // Eliminación: solo admin
      allow delete: if isAdmin();

      // ---- create por admin (desde approve endpoint)
      function validBusinessAdminCreate() {
        return
          ((('businessName' in request.resource.data) && validString(request.resource.data.businessName, 1, 140)) ||
           (('name' in request.resource.data) && validString(request.resource.data.name, 1, 140))) &&
          (!('ownerEmail' in request.resource.data) || validString(request.resource.data.ownerEmail, 5, 200)) &&
          (!('ownerName' in request.resource.data) || optionalString(request.resource.data.ownerName, 140)) &&
          (!('ownerId' in request.resource.data) || validString(request.resource.data.ownerId, 1, 128)) &&
          (!('category' in request.resource.data) || optionalString(request.resource.data.category, 80)) &&
          (!('phone' in request.resource.data) || optionalString(request.resource.data.phone, 30)) &&
          (!('whatsapp' in request.resource.data) || optionalString(request.resource.data.whatsapp, 30)) &&
          (!('status' in request.resource.data) || validStatus(request.resource.data.status)) &&
          (!('businessStatus' in request.resource.data) || validBusinessStatus(request.resource.data.businessStatus)) &&
          (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp) &&
          (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      }

      // ---- create por usuario (si decide crear directo o desde wizard con nuevo sistema)
      function validBusinessUserCreate() {
        let allowedFields = request.resource.data.keys().hasOnly([
          'name', 'businessName',
          'category', 'categoryId', 'categoryName', 'categoryGroupId',
          'address', 'colonia', 'neighborhood', 'description',
          'phone', 'whatsapp', 'WhatsApp',
          'facebookPage', 'Facebook', 'instagramUser', 'emailContact', 'website',
          'hours', 'horarios', 'images', 'logoUrl', 'coverPhoto', 'image1',
          'hasEnvio', 'envioCost', 'envioInfo',
          'lat', 'lng', 'location', 'price',
          'ownerId', 'ownerEmail', 'ownerName', 'ownerPhone',
          'businessStatus', 'createdAt', 'updatedAt'
        ]);
        return isVerifiedEmail() &&
          allowedFields &&
          request.resource.data.ownerId == request.auth.uid &&
          request.auth.token.email is string &&
          (!('ownerEmail' in request.resource.data) ||
            (validString(request.resource.data.ownerEmail, 5, 200) &&
             request.resource.data.ownerEmail == request.auth.token.email)) &&
          request.resource.data.businessStatus == 'draft' &&
          validString(request.resource.data.businessName, 1, 140) &&
          (!('name' in request.resource.data) || validString(request.resource.data.name, 1, 140)) &&
          (!('ownerName' in request.resource.data) || validString(request.resource.data.ownerName, 0, 140)) &&
          (!('ownerPhone' in request.resource.data) || validString(request.resource.data.ownerPhone, 0, 30)) &&
          (!('category' in request.resource.data) || validString(request.resource.data.category, 0, 120)) &&
          (!('categoryId' in request.resource.data) || validString(request.resource.data.categoryId, 0, 120)) &&
          (!('categoryName' in request.resource.data) || validString(request.resource.data.categoryName, 0, 120)) &&
          (!('categoryGroupId' in request.resource.data) || validString(request.resource.data.categoryGroupId, 0, 80)) &&
          (!('address' in request.resource.data) || validString(request.resource.data.address, 0, 400)) &&
          (!('colonia' in request.resource.data) || validString(request.resource.data.colonia, 0, 140)) &&
          (!('neighborhood' in request.resource.data) || validString(request.resource.data.neighborhood, 0, 140)) &&
          (!('description' in request.resource.data) || validString(request.resource.data.description, 0, 2000)) &&
          (!('phone' in request.resource.data) || validString(request.resource.data.phone, 0, 30)) &&
          (!('whatsapp' in request.resource.data) || validString(request.resource.data.whatsapp, 0, 30)) &&
          (!('WhatsApp' in request.resource.data) || validString(request.resource.data.WhatsApp, 0, 30)) &&
          (!('facebookPage' in request.resource.data) || validString(request.resource.data.facebookPage, 0, 300)) &&
          (!('Facebook' in request.resource.data) || validString(request.resource.data.Facebook, 0, 300)) &&
          (!('instagramUser' in request.resource.data) || validString(request.resource.data.instagramUser, 0, 200)) &&
          (!('emailContact' in request.resource.data) || validString(request.resource.data.emailContact, 0, 200)) &&
          (!('website' in request.resource.data) || validString(request.resource.data.website, 0, 300)) &&
          (!('hours' in request.resource.data) || validString(request.resource.data.hours, 0, 500)) &&
          (!('horarios' in request.resource.data) || request.resource.data.horarios is map) &&
          (!('images' in request.resource.data) || request.resource.data.images is list) &&
          (!('logoUrl' in request.resource.data) || validString(request.resource.data.logoUrl, 0, 500)) &&
          (!('coverPhoto' in request.resource.data) || validString(request.resource.data.coverPhoto, 0, 500)) &&
          (!('image1' in request.resource.data) || validString(request.resource.data.image1, 0, 500)) &&
          (!('hasEnvio' in request.resource.data) || request.resource.data.hasEnvio is bool) &&
          (!('envioCost' in request.resource.data) || validString(request.resource.data.envioCost, 0, 40)) &&
          (!('envioInfo' in request.resource.data) || validString(request.resource.data.envioInfo, 0, 500)) &&
          (!('lat' in request.resource.data) || request.resource.data.lat is number) &&
          (!('lng' in request.resource.data) || request.resource.data.lng is number) &&
          (!('location' in request.resource.data) || request.resource.data.location is map) &&
          (!('price' in request.resource.data) ||
            request.resource.data.price is number || request.resource.data.price is string) &&
          (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp) &&
          (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      }

      // ---- update por dueño: solo perfil/contacto, nunca estados ni ownership
      function validBusinessOwnerUpdate() {
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();
        let sameOwner = request.resource.data.ownerId == resource.data.ownerId &&
          ((!('ownerEmail' in resource.data) && !('ownerEmail' in request.resource.data)) ||
           (('ownerEmail' in resource.data) && ('ownerEmail' in request.resource.data) &&
            request.resource.data.ownerEmail == resource.data.ownerEmail));

        return changedFields.hasOnly([
          'name', 'businessName',
          'category', 'categoryId', 'categoryName', 'categoryGroupId',
          'address', 'colonia', 'neighborhood', 'description',
          'phone', 'whatsapp', 'WhatsApp',
          'facebookPage', 'Facebook', 'instagramUser', 'emailContact', 'website',
          'hours', 'horarios', 'images', 'logoUrl', 'coverPhoto', 'image1',
          'hasEnvio', 'envioCost', 'envioInfo',
          'lat', 'lng', 'location', 'price',
          'updatedAt'
        ]) &&
          sameOwner &&
          (!changedFields.hasAny(['name']) || validString(request.resource.data.name, 1, 140)) &&
          (!changedFields.hasAny(['businessName']) || validString(request.resource.data.businessName, 1, 140)) &&
          (!changedFields.hasAny(['category']) || validString(request.resource.data.category, 0, 120)) &&
          (!changedFields.hasAny(['categoryId']) || validString(request.resource.data.categoryId, 0, 120)) &&
          (!changedFields.hasAny(['categoryName']) || validString(request.resource.data.categoryName, 0, 120)) &&
          (!changedFields.hasAny(['categoryGroupId']) || validString(request.resource.data.categoryGroupId, 0, 80)) &&
          (!changedFields.hasAny(['address']) || validString(request.resource.data.address, 0, 400)) &&
          (!changedFields.hasAny(['colonia']) || validString(request.resource.data.colonia, 0, 140)) &&
          (!changedFields.hasAny(['neighborhood']) || validString(request.resource.data.neighborhood, 0, 140)) &&
          (!changedFields.hasAny(['description']) || validString(request.resource.data.description, 0, 2000)) &&
          (!changedFields.hasAny(['phone', 'whatsapp', 'WhatsApp']) ||
            ((!changedFields.hasAny(['phone']) || validString(request.resource.data.phone, 0, 30)) &&
             (!changedFields.hasAny(['whatsapp']) || validString(request.resource.data.whatsapp, 0, 30)) &&
             (!changedFields.hasAny(['WhatsApp']) || validString(request.resource.data.WhatsApp, 0, 30)))) &&
          (!changedFields.hasAny(['facebookPage']) || validString(request.resource.data.facebookPage, 0, 300)) &&
          (!changedFields.hasAny(['Facebook']) || validString(request.resource.data.Facebook, 0, 300)) &&
          (!changedFields.hasAny(['instagramUser']) || validString(request.resource.data.instagramUser, 0, 200)) &&
          (!changedFields.hasAny(['emailContact']) || validString(request.resource.data.emailContact, 0, 200)) &&
          (!changedFields.hasAny(['website']) || validString(request.resource.data.website, 0, 300)) &&
          (!changedFields.hasAny(['hours']) || validString(request.resource.data.hours, 0, 500)) &&
          (!changedFields.hasAny(['horarios']) || request.resource.data.horarios is map) &&
          (!changedFields.hasAny(['images']) || request.resource.data.images is list) &&
          (!changedFields.hasAny(['logoUrl']) || validString(request.resource.data.logoUrl, 0, 500)) &&
          (!changedFields.hasAny(['coverPhoto']) || validString(request.resource.data.coverPhoto, 0, 500)) &&
          (!changedFields.hasAny(['image1']) || validString(request.resource.data.image1, 0, 500)) &&
          (!changedFields.hasAny(['hasEnvio']) || request.resource.data.hasEnvio is bool) &&
          (!changedFields.hasAny(['envioCost']) || validString(request.resource.data.envioCost, 0, 40)) &&
          (!changedFields.hasAny(['envioInfo']) || validString(request.resource.data.envioInfo, 0, 500)) &&
          (!changedFields.hasAny(['lat']) || request.resource.data.lat is number) &&
          (!changedFields.hasAny(['lng']) || request.resource.data.lng is number) &&
          (!changedFields.hasAny(['location']) || request.resource.data.location is map) &&
          (!changedFields.hasAny(['price']) ||
            request.resource.data.price is number || request.resource.data.price is string) &&
          (!changedFields.hasAny(['updatedAt']) || request.resource.data.updatedAt is timestamp);
      }

      // ---- update por admin (puede cambiar cualquier cosa incluyendo estados)
      function validBusinessAdminUpdate() {
        return
          (!('businessName' in request.resource.data) || optionalString(request.resource.data.businessName, 140)) &&
          (!('name' in request.resource.data) || optionalString(request.resource.data.name, 140)) &&
          (!('ownerName' in request.resource.data) || optionalString(request.resource.data.ownerName, 140)) &&
          (!('ownerEmail' in request.resource.data) || optionalString(request.resource.data.ownerEmail, 200)) &&
          (!('ownerId' in request.resource.data) || validString(request.resource.data.ownerId, 1, 128)) &&
          (!('category' in request.resource.data) || optionalString(request.resource.data.category, 80)) &&
          (!('address' in request.resource.data) || optionalString(request.resource.data.address, 300)) &&
          (!('description' in request.resource.data) || optionalString(request.resource.data.description, 2000)) &&
          (!('phone' in request.resource.data) || optionalString(request.resource.data.phone, 30)) &&
          (!('whatsapp' in request.resource.data) || optionalString(request.resource.data.whatsapp, 30)) &&
          (!('featured' in request.resource.data) || request.resource.data.featured is bool) &&
          // Compatibilidad: mantener validación status antiguo
          (!('status' in request.resource.data) || validStatus(request.resource.data.status)) &&
          // NUEVO: Admin puede cambiar todos los estados
          (!('businessStatus' in request.resource.data) || validBusinessStatus(request.resource.data.businessStatus)) &&
          (!('applicationStatus' in request.resource.data) || validApplicationStatus(request.resource.data.applicationStatus)) &&
          (!('completionPercent' in request.resource.data) || (request.resource.data.completionPercent is number && request.resource.data.completionPercent >= 0 && request.resource.data.completionPercent <= 100)) &&
          (!('isPublishReady' in request.resource.data) || request.resource.data.isPublishReady is bool) &&
          (!('isActive' in request.resource.data) || request.resource.data.isActive is bool) &&
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus is string) &&
          (!('nextPaymentDate' in request.resource.data) || request.resource.data.nextPaymentDate is string) &&
          (!('lastPaymentDate' in request.resource.data) || request.resource.data.lastPaymentDate is string) &&
          (!('disabledReason' in request.resource.data) || optionalString(request.resource.data.disabledReason, 500)) &&
          (!('paymentHistory' in request.resource.data) || request.resource.data.paymentHistory is list) &&
          (!('rejectionReason' in request.resource.data) || optionalString(request.resource.data.rejectionReason, 500)) &&
          (!('adminNotes' in request.resource.data) || optionalString(request.resource.data.adminNotes, 1000)) &&
          (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      }
    }

    // ============== RESEÑAS (NESTED COLLECTION) ==============
    match /businesses/{bid}/reviews/{uid} {
      // Lectura: solo reseñas aprobadas para usuarios normales, admin ve todas
      allow read: if !('approved' in resource.data) || resource.data.approved == true || isAdmin();

      // Crear: usuario autenticado, UID = auth.uid, no es owner, datos válidos
      // Las nuevas reseñas se crean con approved=true por defecto
      allow create: if isSignedIn()
        && uid == request.auth.uid
        && exists(/databases/$(database)/documents/businesses/$(bid))
        && !isOwner(bid)
        && validReviewCreate();

      // Actualizar: el mismo usuario o admin. Admin puede cambiar 'approved'.
      allow update: if isSignedIn()
        && ((uid == request.auth.uid && !('approved' in request.resource.data || request.resource.data.approved == resource.data.approved))
            || isAdmin())
        && validReviewUpdate();

      // Borrar: el mismo usuario o admin
      allow delete: if isSignedIn()
        && (uid == request.auth.uid || isAdmin());

      function validReviewCreate() {
        return
          (request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5) &&
          validString(request.resource.data.text, 10, 500) &&
          validString(request.resource.data.name, 2, 100) &&
          (!('created' in request.resource.data) || request.resource.data.created is timestamp) &&
          (!('updated' in request.resource.data) || request.resource.data.updated is timestamp) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
          (!('businessId' in request.resource.data) || request.resource.data.businessId == bid) &&
          (!('approved' in request.resource.data) || request.resource.data.approved is bool);
      }

      function validReviewUpdate() {
        return
          (request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5) &&
          validString(request.resource.data.text, 10, 500) &&
          validString(request.resource.data.name, 2, 100) &&
          (('created' in resource.data && 'created' in request.resource.data)
            ? request.resource.data.created == resource.data.created
            : true) &&
          (!('updated' in request.resource.data) || request.resource.data.updated is timestamp) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
          (!('businessId' in request.resource.data) || request.resource.data.businessId == resource.data.businessId) &&
          (!('approved' in request.resource.data) || request.resource.data.approved is bool);
      }
    }

    // ============== WIZARD PROGRESS ==============
    match /business_wizard/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ============== TELEMETRY EVENTS ==============
    // Los eventos de telemetría solo son escritos por el API endpoint del servidor
    // Los admins pueden leerlos desde el dashboard de analytics
    match /telemetry_events/{eventId} {
      // Solo admins pueden leer
      allow read: if isAdmin();
      
      // Nadie puede escribir directamente (solo el API server-side)
      allow write: if false;
    }

    // ============== BUSINESS REPORTS ==============
    // Los reportes de negocios solo se crean desde el API
    // Los admins pueden leerlos y actualizarlos
    match /business_reports/{reportId} {
      // Solo admins pueden leer
      allow read: if isAdmin();
      
      // Nadie puede escribir directamente (solo el API server-side)
      allow write: if false;
    }

    // ============== RECLAMOS (opcional) ==============
    match /claims/{claimId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId));

      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ============== NOTIFICATIONS (logs de notificaciones WhatsApp) ==============
    // Usado por el sistema de notificaciones para idempotencia
    match /notifications/{notificationId} {
      // Solo admins y el sistema pueden leer
      allow read: if isAdmin() || isSignedIn();
      
      // Solo el sistema puede crear logs (server-side)
      allow create: if isSignedIn();
      
      // Solo el sistema puede actualizar logs
      allow update: if isSignedIn();
      
      // Solo admins pueden eliminar
      allow delete: if isAdmin();
    }

    // ============== WAITLIST (Lista de espera para planes) ==============
    match /waitlist/{waitlistId} {
      // Lectura: solo el dueño del negocio o admin
      allow read: if isSignedIn() && (
        isOwner(resource.data.businessId) || isAdmin()
      );
      
      // Monetización desactivada: ningún cliente puede activar la lista de espera.
      allow create: if false;
      
      // Actualización: solo Cloud Functions o admin
      allow update: if isAdmin();
      
      // Eliminación: solo admin
      allow delete: if isAdmin();
      
      function validWaitlistCreate() {
        return
          request.resource.data.businessId is string &&
          request.resource.data.category is string &&
          request.resource.data.targetPlan in ['featured', 'sponsor'] &&
          request.resource.data.status == 'waiting' &&
          request.resource.data.createdAt is timestamp;
      }
    }

    // ============== PURCHASES (Compras de paquetes) ==============
    match /purchases/{purchaseId} {
      // Lectura: solo el dueño del negocio o admin
      allow read: if isSignedIn() && (
        isOwner(resource.data.businessId) || isAdmin()
      );
      
      // Monetización desactivada: ningún cliente puede registrar compras.
      allow create: if false;
      
      // Actualización: solo admin o sistema
      allow update: if isAdmin();
      
      // Eliminación: solo admin
      allow delete: if isAdmin();
      
      function validPurchaseCreate() {
        return
          request.resource.data.businessId is string &&
          request.resource.data.packageId in ['esencial', 'destacado', 'lider'] &&
          request.resource.data.amount is number &&
          request.resource.data.amount >= 0 &&
          request.resource.data.createdAt is timestamp;
      }
    }

    // ============== REPORTS (Reportes del sistema) ==============
    match /reports/{reportId} {
      // Solo admins pueden leer
      allow read: if isAdmin();
      
      // Solo el sistema puede crear reportes
      allow create: if isSignedIn();
      
      // Solo admin puede actualizar/eliminar
      allow update, delete: if isAdmin();
    }
  }
}
